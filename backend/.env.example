# ==============================================================================
# ClauseGuard AI — Production Environment Variables Reference
# Configure these variables in the Render Web Service Settings
# ==============================================================================

# Core Flask & Security
FLASK_ENV=production
FLASK_DEBUG=0
PORT=10000
SECRET_KEY=generate-a-secure-random-64-char-string
JWT_SECRET=generate-a-secure-random-64-char-string

# PostgreSQL Database (e.g. Neon Serverless PostgreSQL)
DATABASE_URL=postgresql+psycopg2://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# External Cloud APIs (Backend only - never expose to frontend)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Privacy & Data Protection (AES encryption for raw text at rest)
FIELD_ENCRYPTION_KEY=generate-a-32-byte-key-and-base64-encode-it

# Network & CORS (Add your Vercel deployment URL)
FRONTEND_URL=https://your-clauseguard-frontend.vercel.app
CORS_ORIGINS=https://your-clauseguard-frontend.vercel.app,http://localhost:5173

# Document Ingestion limits
MAX_UPLOAD_MB=20

# Optional: Path to model artifacts (Defaults to ./models inside backend)
# MODELS_DIR=./models
