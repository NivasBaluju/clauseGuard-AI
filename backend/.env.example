FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard
GEMINI_API_KEY=your-gemini-api-key-here
FIELD_ENCRYPTION_KEY=generate-a-32-byte-key-and-base64-encode-it
TESSERACT_CMD=/usr/bin/tesseract
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
BASELINE_MODEL_PATH=./ml/artifacts/baseline_tfidf_lr.joblib
BERT_CLAUSE_TYPE_MODEL_PATH=./ml/artifacts/bert_clause_type/final
BERT_FAVORABILITY_MODEL_PATH=./ml/artifacts/bert_favorability/final
